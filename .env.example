# Fiscus environment overrides.
#
# Copy to .env for use with Docker Compose or your process manager, then fill in
# your own values. Never commit .env. Variables override config.yaml.

# Dashboard HTTP server
FISCUS_SERVER_ADDRESS=:8080
FISCUS_SERVER_USERNAME=
FISCUS_SERVER_PASSWORD=
# Prefer FISCUS_SERVER_PASSWORD_HASH with a bcrypt hash in production.
FISCUS_SERVER_PASSWORD_HASH=
# Set both to serve HTTPS directly. Enable Banking production needs https.
FISCUS_SERVER_TLS_CERT_FILE=
FISCUS_SERVER_TLS_KEY_FILE=

# SQLite storage
FISCUS_DATABASE_PATH=data/fiscus.db

# Select the banking provider: enablebanking or gocardless.
FISCUS_PROVIDER=enablebanking

# Workspace profile: personal, business, or hybrid.
FISCUS_PROFILE=hybrid

# Receipt storage managed by Fiscus.
FISCUS_ATTACHMENTS_ENABLED=true
FISCUS_ATTACHMENTS_DIRECTORY=data/attachments
FISCUS_ATTACHMENTS_MAX_SIZE_BYTES=10485760
FISCUS_ATTACHMENTS_RECEIPT_THRESHOLD_MINOR=5000
FISCUS_ATTACHMENTS_GRACE_DAYS=5

# Quarterly tax shield (business/hybrid profiles).
FISCUS_TAX_ENABLED=true
FISCUS_TAX_VAT_RATE_DEFAULT=0.21
FISCUS_TAX_INCOME_TAX_RETENTION=0.15
FISCUS_TAX_QUARTER_START_MONTHS=1,4,7,10

# GoCardless Bank Account Data API
FISCUS_GOCARDLESS_BASE_URL=https://bankaccountdata.gocardless.com/api/v2
FISCUS_GOCARDLESS_SECRET_ID=
FISCUS_GOCARDLESS_SECRET_KEY=
FISCUS_GOCARDLESS_REDIRECT_URL=http://localhost:8080/
FISCUS_GOCARDLESS_COUNTRY=ES
FISCUS_GOCARDLESS_INSTITUTION_ID=
FISCUS_GOCARDLESS_INSTITUTION_NAME=
# Six hours matches the PSD2 limit of four unattended accesses per day.
FISCUS_GOCARDLESS_SYNC_INTERVAL=6h
FISCUS_GOCARDLESS_SYNC_TIMEOUT=5m
FISCUS_GOCARDLESS_INITIAL_LOOKBACK_DAYS=90
FISCUS_GOCARDLESS_OVERLAP_DAYS=3

# Enable Banking (set FISCUS_PROVIDER=enablebanking to use it)
FISCUS_ENABLEBANKING_BASE_URL=https://api.enablebanking.com
FISCUS_ENABLEBANKING_APP_ID=
# Prefer a mounted key file in production.
FISCUS_ENABLEBANKING_PRIVATE_KEY_PATH=
# Alternative to PRIVATE_KEY_PATH; use a secret manager rather than .env.
FISCUS_ENABLEBANKING_PRIVATE_KEY=
FISCUS_ENABLEBANKING_REDIRECT_URL=https://localhost:8080/callback
FISCUS_ENABLEBANKING_COUNTRY=ES
FISCUS_ENABLEBANKING_INSTITUTION_NAME=Banco Santander
FISCUS_ENABLEBANKING_PSU_TYPE=personal
FISCUS_ENABLEBANKING_CONSENT_VALIDITY_DAYS=90
FISCUS_ENABLEBANKING_SYNC_INTERVAL=6h
FISCUS_ENABLEBANKING_SYNC_TIMEOUT=5m
FISCUS_ENABLEBANKING_INITIAL_LOOKBACK_DAYS=90
FISCUS_ENABLEBANKING_OVERLAP_DAYS=3

# Alert rules
FISCUS_ALERTS_DUPLICATE_WINDOW=24h
FISCUS_ALERTS_ANOMALY_THRESHOLD=0.30
FISCUS_ALERTS_ANOMALY_LOOKBACK_DAYS=90
FISCUS_ALERTS_ANOMALY_MIN_HISTORY=3
# Comma-separated CUR:AMOUNT pairs, for example "EUR:500.00,USD:250.00".
FISCUS_LIQUIDITY_THRESHOLDS=EUR:500.00
FISCUS_ALERTS_RETRY_ATTEMPTS=3
FISCUS_ALERTS_RETRY_BASE_DELAY=500ms

# Notification channels (leave empty to disable)
FISCUS_TELEGRAM_BOT_TOKEN=
FISCUS_TELEGRAM_CHAT_ID=
FISCUS_DISCORD_WEBHOOK_URL=

# Logging
FISCUS_LOG_LEVEL=info
FISCUS_LOG_FORMAT=text
