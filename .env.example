# Fiscus environment overrides.
#
# Copy to .env for use with Docker Compose or your process manager, then fill in
# your own values. Never commit .env. Variables override config.yaml.

# Dashboard HTTP server
FISCUS_SERVER_ADDRESS=:8080
FISCUS_SERVER_USERNAME=
FISCUS_SERVER_PASSWORD=
# Prefer FISCUS_SERVER_PASSWORD_HASH with a bcrypt hash in production.
FISCUS_SERVER_PASSWORD_HASH=

# SQLite storage
FISCUS_DATABASE_PATH=data/fiscus.db

# GoCardless Bank Account Data API
FISCUS_GOCARDLESS_BASE_URL=https://bankaccountdata.gocardless.com/api/v2
FISCUS_GOCARDLESS_SECRET_ID=
FISCUS_GOCARDLESS_SECRET_KEY=
FISCUS_GOCARDLESS_REDIRECT_URL=http://localhost:8080/
FISCUS_GOCARDLESS_COUNTRY=ES
FISCUS_GOCARDLESS_INSTITUTION_ID=
FISCUS_GOCARDLESS_INSTITUTION_NAME=
FISCUS_GOCARDLESS_SYNC_INTERVAL=15m
FISCUS_GOCARDLESS_SYNC_TIMEOUT=5m
FISCUS_GOCARDLESS_INITIAL_LOOKBACK_DAYS=90
FISCUS_GOCARDLESS_OVERLAP_DAYS=3

# Alert rules
FISCUS_ALERTS_DUPLICATE_WINDOW=24h
FISCUS_ALERTS_ANOMALY_THRESHOLD=0.30
FISCUS_ALERTS_ANOMALY_LOOKBACK_DAYS=90
FISCUS_ALERTS_ANOMALY_MIN_HISTORY=3
# Comma-separated CUR:AMOUNT pairs, for example "EUR:500.00,USD:250.00".
FISCUS_LIQUIDITY_THRESHOLDS=EUR:500.00
FISCUS_ALERTS_RETRY_ATTEMPTS=3
FISCUS_ALERTS_RETRY_BASE_DELAY=500ms

# Notification channels (leave empty to disable)
FISCUS_TELEGRAM_BOT_TOKEN=
FISCUS_TELEGRAM_CHAT_ID=
FISCUS_DISCORD_WEBHOOK_URL=

# Logging
FISCUS_LOG_LEVEL=info
FISCUS_LOG_FORMAT=text
